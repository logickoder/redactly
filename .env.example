# Copy to .env.local and fill in values.

# GoatCounter site code (the subdomain part of your-site.goatcounter.com).
# Recommended: create a dedicated site for Redactly so events don't mix with
# other projects under your account. Settings → Sites → Add site → code: "redactly".
# Endpoint becomes https://redactly.goatcounter.com/count.
# Leave empty to disable analytics entirely — script never loads.
VITE_GOATCOUNTER_CODE=redactly
